# Telegram bot
UCONTENT_BOT_TOKEN=

# Required for local telegram-bot-api. Get from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local service URLs. In Docker compose these are overridden to service names.
BASE_API_URL=http://127.0.0.1:8081/bot
BASE_FILE_URL=http://127.0.0.1:8081/file
UCONTENT_PORT=5197
# Set to 0 to disable the automatically refreshed trycloudflare.com Web App URL.
UCONTENT_QUICK_TUNNEL=1
# Docker Chrome profile used by Screenshot Lab. Cookies/localStorage persist here.
# SCREENSHOT_BROWSER_PROFILE_DIR=/app/data/browser-profile
# SCREENSHOT_REMOTE_DEBUGGING_PORT=9222
# SCREENSHOT_VNC_PORT=5900
# SCREENSHOT_NOVNC_PORT=6080

# Portable local folders
# Native path for running Node directly on this host.
PAMPAM_ROOT=./media
MEDIA_DOWNLOAD_ROOT=./media
# Runtime-only staging/cache/quarantine. Downloaders write here first; only validated final files are published to PAMPAM_ROOT.
UCONTENT_STAGING_ROOT=./.staging
# Host path mounted by Docker Compose at the portable container path /app/media.
# Windows example: C:/Users/Name/YandexDisk/PAMPAM
# macOS example: /Users/name/Yandex.Disk/PAMPAM
PAMPAM_HOST_ROOT=./media
UTRENDS_ROOT=./tools/utrends
UCONTENT_PYTHON=./.venv/Scripts/python.exe
# Optional separate interpreter for RSS/SearXNG research. Defaults to UCONTENT_PYTHON.
UTRENDS_PYTHON=./.venv/Scripts/python.exe
RESEARCH_SEARXNG_URL=http://127.0.0.1:8888

# Optional explicit tool paths
# UCONTENT_YTDLP_PATH=./.venv/Scripts/yt-dlp.exe
# UCONTENT_GALLERYDL_PATH=./.venv/Scripts/gallery-dl.exe
# FFMPEG_PATH=ffmpeg
# Optional yt-dlp cookies for restricted sources.
# Docker: put exported Netscape cookies into ./data/cookies.txt and use the container path below.
# MEDIA_COOKIES_PATH=/app/data/cookies.txt
# Native host run only: yt-dlp may read your browser profile directly.
# MEDIA_COOKIES_FROM_BROWSER=Firefox
# Optional YouTube JS challenge runtime. Docker default is node; native Windows can point to MediaDownloader's deno.exe.
# MEDIA_YTDLP_JS_RUNTIME=node
# MEDIA_YTDLP_JS_RUNTIME=deno:C:/Users/Name/Documents/MediaDownloaderQt6-5.4.2/local/bin/deno.exe
# Optional raw yt-dlp args. Prefer JSON array when paths contain spaces.
# MEDIA_YTDLP_EXTRA_ARGS=["--no-js-runtimes","--js-runtimes","deno:C:/path/to/deno.exe"]

# /voice TTS host service. Start it before using /voice:
# powershell -ExecutionPolicy Bypass -File tools/start-tts-host.ps1
# Dockerized ucontent reaches the host service through this URL.
# VOICE_TTS_URL=http://host.docker.internal:8765
# Default local checkpoint path: C:/Ucontent/data/models/my_russian_voice/model_last.pt
